<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Update der GitHub-APK in der App laden und dem System-Installer
         übergeben (PilzBuddy #161). Bewusst NUR diese eine Berechtigung:
         die App BIETET eine Datei an, den Installationsdialog zeigt
         Android. Der `play`-Flavor nimmt sie wieder heraus — Selbst-Updates
         verstoßen dort gegen „Device and Network Abuse". -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!-- Die eigene Position als Punkt auf der Karte. Nur im Vordergrund,
         gefragt erst beim Tipp auf „Meine Position"; die Position bleibt
         auf dem Gerät. Ausdrücklich NICHT ACCESS_BACKGROUND_LOCATION —
         die Aufzeichnung (Phase 2) bringt ihren Vordergrunddienst mit. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- Fahrt aufzeichnen (#28): ein Foreground-Service vom Typ `location`
         hält den Prozess wach und trägt das Isolate, das misst — auch mit
         dem Telefon in der Tasche. Ab Android 14 prüft das System je
         Service-Typ die passende Berechtigung; ohne FOREGROUND_SERVICE_LOCATION
         liefert der Dienst im Hintergrund keine Standorte mehr.
         **Ausdrücklich NICHT ACCESS_BACKGROUND_LOCATION**: Die Aufnahme
         startet der Nutzer, und die Dauerbenachrichtigung ist die
         Offenlegung. POST_NOTIFICATIONS, damit sie ab Android 13 sichtbar
         ist. RECEIVE_BOOT_COMPLETED bringt das Plugin für autoRunOnBoot mit;
         wir starten nie beim Booten, also raus. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Bringt flutter_local_notifications mit (#116, die Frage während
         der Fahrt); hier ausgeschrieben, damit die Liste vollständig ist.
         Eine normale Berechtigung, Android fragt nicht nach. -->
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"
        tools:node="remove"/>
    <application
        android:label="TrailBuddy"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:fullBackupContent="@xml/full_backup_content"
        android:dataExtractionRules="@xml/backup_rules">
        <!-- supportsPictureInPicture: die Navigation als schwebendes
             Fenster (#232, Konzept-Routing 9.6), nur solange sie läuft
             (MainActivity, Kanal `pip`). Keine Berechtigung — anders als
             SYSTEM_ALERT_WINDOW, das Play nur eng freigibt. Die
             configChanges um screenSize|smallestScreenSize|screenLayout|
             orientation braucht das Fenster, damit die Activity beim
             Schrumpfen nicht neu startet. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:supportsPictureInPicture="true"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Der EINE Foreground-Service der App (flutter_foreground_task):
             die Fahrt (`location`) und der Bereichs-Download (`dataSync`),
             geteilt über den KeepAlive-Koordinator. Der Klassenname stammt
             aus dem Paket und darf nicht geändert werden. Die Typen hier
             sind die Obermenge; welche ein Lauf nennt, entscheidet der
             Koordinator je Start (PilzBuddy #338). -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="dataSync|location"
            android:exported="false"/>
        <!-- Das Symbol der Meldung. Android wertet ein Statusleisten-Symbol
             NUR über den Alphakanal aus; das Launcher-Icon würde ein weißer
             Klotz (PilzBuddy #331). Das Plugin sucht das Drawable
             ausschließlich über diesen Meta-Data-Namen; ein Tippfehler
             liefert stumm die Ressourcen-id 0 — der Name steht deshalb als
             Konstante in Dart (ride_service_android.dart), ein Test hält
             beide Seiten zusammen. -->
        <meta-data
            android:name="de.mcbuchi.trailbuddy.RIDE_NOTIFICATION_ICON"
            android:resource="@drawable/ic_notification" />
        <!-- Push (#34): der Kanal, auf dem FCM Meldungen anzeigt. Ohne
             diese Zeile legt FCM still einen eigenen, LEISEN Kanal an —
             nur ein Symbol in der Statusleiste, kein Banner (PilzBuddy
             #277). Die Wichtigkeit lässt sich nach dem ersten Anlegen
             NICHT mehr ändern; angelegt wird der Kanal in
             MainActivity.onCreate mit IMPORTANCE_HIGH. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/notification_channel_id" />
        <!-- Dasselbe Alpha-Symbol wie bei der Fahrt; ohne diese Zeile nähme
             FCM das Launcher-Icon, als Silhouette ein weißer Klotz. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_color" />
        <!-- Die Knöpfe der Frage während der Fahrt (#116, „Stimmt",
             „Trail ist frei"): Ohne diesen Empfänger tut ein Tipp darauf
             nichts, ohne Fehlermeldung. Nicht exportiert — nur die eigene
             Benachrichtigung ruft ihn. -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ActionBroadcastReceiver" />
        <!-- Reicht die geladene Update-APK an den System-Installer heraus
             (content-URI mit Leseerlaubnis; `file://` ist ab Android 7
             verboten). `exported="false"`: nur wer die Erlaubnis bekommt,
             darf lesen. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"/>
        </provider>
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- url_launcher: Release-Seite und APK im Browser öffnen -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <!-- url_launcher: den Trailkopf an eine Navi-App übergeben (#151).
             Ohne diesen Eintrag sieht die App ab Android 11 keinen
             Empfänger für geo:, der Wähler bleibt aus, und der Knopf
             fällt still auf die Zwischenablage zurück. Das Schema steht
             als kGeoScheme in trail_navigation.dart; der Manifest-Test
             hält beide zusammen. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="geo"/>
        </intent>
    </queries>
</manifest>
